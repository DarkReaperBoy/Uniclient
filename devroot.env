export PATH="/home/z/.local/go/bin:$PATH"
export PKG_CONFIG_PATH="/home/z/.local/sysroot/usr/lib/x86_64-linux-gnu/pkgconfig"
export CGO_LDFLAGS="-L/home/z/.local/sysroot/usr/lib/x86_64-linux-gnu"
export CGO_CFLAGS="-I/home/z/.local/sysroot/usr/include"
export LD_LIBRARY_PATH="/home/z/.local/sysroot/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
export GOGC=20
