# Credentials — never commit
auth/
*.vault

# Go build output & binaries
go/build/
go/result*
*.so
*.dll
*.dylib
*.wasm
*.exe

# Test files — live API tests, not committed
go/tests/

# DC test account data (from Python deltachat-rpc-server)
go/accounts/

# Session files
/tmp/uniclient_*

# Nix build artifacts
result
result-dev

# Generated protobuf Go code (regenerated by scripts/gen_proto.sh)
proto/*.pb.go

# Ralph loop logs
logs/

# IDE
.idea/
.vscode/
*.swp

# Flutter
dart/.dart_tool/
dart/build/
dart/.packages
dart/linux/flutter/ephemeral/
dart/native_assets/
dart/.flutter-plugins
dart/.flutter-plugins-dependencies
.ralph.lock
